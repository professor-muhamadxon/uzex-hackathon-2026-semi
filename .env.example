# --- Data ---
DATA_DIR=data/uzex_spot_data
DB_PATH=data/uzex.duckdb

# --- LLM (OpenAI-compatible) ---
# Cloud example: LLM_BASE_URL=https://api.openai.com/v1
# Local Ollama example: LLM_BASE_URL=http://localhost:11434/v1
LLM_ENABLED=0
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:7b
# Local thinking models (qwen3) need a larger timeout: the first call loads the model.
LLM_TIMEOUT=60
# Ollama: "none" stops qwen3-style models from spending the whole token budget on
# reasoning (they otherwise return empty content). Leave empty for cloud endpoints.
LLM_REASONING_EFFORT=none
# 0 = LLM only classifies meaning (safe); 1 = LLM may also write SQL (validated)
LLM_SQL=0

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Monitoring relay: copy each incoming question to a second Telegram chat ---
# Telegram does not deliver a bot's messages to another bot, so the second bot
# is used as the SENDER only: its token posts a copy into a chat your team watches.
# Leave RELAY_CHAT_ID empty to keep the relay off.
#
# RELAY_BOT_TOKEN  = token of the second bot (empty -> same as TELEGRAM_BOT_TOKEN)
# RELAY_CHAT_ID    = group -100... , @channel, or a user id that pressed /start
# RELAY_ENABLED    = 1/0 master switch
# RELAY_ANSWERS    = 1 -> also send the answer, 0 -> questions only
# RELAY_SQL        = 1 -> include the executed SQL in the answer copy
# RELAY_THREAD_ID  = forum topic id (optional)
RELAY_CHAT_ID=
RELAY_BOT_TOKEN=
RELAY_ENABLED=1
RELAY_ANSWERS=1
RELAY_SQL=0
RELAY_THREAD_ID=

# --- Agent ---
MAX_RESULT_ROWS=200

# --- RAG name retrieval (typo-tolerant names; unknown product word -> "not found") ---
RAG_ENABLED=0
