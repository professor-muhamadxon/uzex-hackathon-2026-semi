# --- Data ---
DATA_DIR=data/uzex_spot_data
DB_PATH=data/uzex.duckdb

# --- LLM (OpenAI-compatible) ---
# Cloud example: LLM_BASE_URL=https://api.openai.com/v1
# Local Ollama example: LLM_BASE_URL=http://localhost:11434/v1
LLM_ENABLED=0
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:7b
LLM_TIMEOUT=20
# 0 = LLM only classifies meaning (safe); 1 = LLM may also write SQL (validated)
LLM_SQL=0

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Agent ---
MAX_RESULT_ROWS=200
